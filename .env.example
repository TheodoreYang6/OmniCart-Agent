# OmniCart Agent local development configuration template
# Copy this file to .env and replace only the machine-local paths and secrets.
# Never commit .env.

# Service
OMNICART_SERVICE_NAME=omnicart-agent
OMNICART_VERSION=2.0.0
OMNICART_HOST=127.0.0.1
OMNICART_PORT=8006

# Web session and CORS
# Generate a unique value of at least 32 random bytes for every installation.
OMNICART_SESSION_SECRET=replace-with-at-least-32-random-bytes
OMNICART_GUEST_TTL_DAYS=30
OMNICART_SESSION_COOKIE_SECURE=false
OMNICART_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
OMNICART_ALLOW_LEGACY_USER_ID=false

# Hosted chat / vision providers (leave unused keys empty)
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=qwen3-embedding
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Runtime mode and retrieval
OMNICART_MOCK_MODE=false
OMNICART_DEMO_DATA_DIR=data
OMNICART_DEFAULT_TOP_K=10
OMNICART_USE_LOCAL_MODELS=true
# Example for Windows; change this path to the model directory on the new machine.
OMNICART_MODELS_DIR=D:/OmniCart-Agent-runtime/models
OMNICART_RERANKER=bge
EMBEDDING_DIMENSION=1024
OMNICART_ENABLE_HYBRID=true
OMNICART_ENABLE_HYBRID_RETRIEVAL=true
OMNICART_ENABLE_RERANK=true

# PostgreSQL
# Replace <password> locally. Do not put a real password in this template.
DATABASE_URL=postgresql+asyncpg://omnicart:<password>@127.0.0.1:5432/omnicart

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_NAME=product_chunks_v7_hybrid
OMNICART_CHUNK_COLLECTION=product_chunks_v7_hybrid

# Redis (DB 1 is reserved for this project)
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_CACHE_TTL_VISUAL=3600
REDIS_CACHE_TTL_SEARCH=300
REDIS_CACHE_TTL_REWRITE=1800
REDIS_CACHE_TTL_WORKFLOW=300
