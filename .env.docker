# OmniCart Agent — Docker 环境变量
# 部署时复制为 .env 并填入真实密钥

# ---- 服务 ----
OMNICART_SERVICE_NAME=omnicart-agent
OMNICART_VERSION=0.1.0
OMNICART_HOST=0.0.0.0
OMNICART_PORT=8006

# ---- Qwen API ----
QWEN_API_KEY=your-api-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ---- 检索 ----
OMNICART_DEFAULT_TOP_K=10

# ---- Mock Mode ----
OMNICART_MOCK_MODE=false
OMNICART_DEMO_DATA_DIR=data

# ---- Decision Agent ----
OMNICART_ENABLE_EVIDENCE_SCORING=false

# ---- PostgreSQL (Docker 服务名) ----
DATABASE_URL=postgresql+asyncpg://omnicart:omnicart@postgres:5432/omnicart

# ---- Qdrant (Docker 服务名) ----
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=products
EMBEDDING_DIMENSION=1024

# ---- Redis (Docker 服务名) ----
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_VISUAL=3600
REDIS_CACHE_TTL_SEARCH=300
REDIS_CACHE_TTL_REWRITE=1800
REDIS_CACHE_TTL_WORKFLOW=300
