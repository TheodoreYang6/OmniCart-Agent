# ===== Downloaded AI model weights and provider caches =====
# Re-download these on a new machine; they are too large for normal Git hosting.
models/
# Product ORM source lives under backend/app/models; keep downloaded model weights
# ignored while allowing newly added ORM modules to be versioned.
!backend/app/models/
!backend/app/models/product_identity.py
.cache/
**/.cache/huggingface/
*.safetensors
*.gguf
*.onnx
pytorch_model*.bin

